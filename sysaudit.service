[Unit]
Description=System Health Monitor and Security Audit Daemon
After=network.target

[Service]
Type=simple
User=auditmanager
WorkingDirectory=/home/aaron/CIS_341_Project
ExecStart=/usr/bin/python3 -u /home/aaron/CIS_341_Project/daemon_runner.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target